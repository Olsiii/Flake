# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings > Database > Connection string in the Supabase dashboard.
# Only needed to run `npm run db:migrate` (no Supabase CLI in this setup).
DATABASE_URL=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Base URL the bucket is publicly reachable at (r2.dev subdomain or a custom
# domain bound to the bucket in the Cloudflare dashboard), no trailing slash.
R2_PUBLIC_URL=

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# Resend
RESEND_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=
