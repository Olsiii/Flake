# Site
# Absolute base URL (no trailing slash) — used for sitemap.xml, canonical
# links, and JSON-LD `url` fields. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings > Database > Connection string in the Supabase dashboard.
# Only needed to run `pnpm db:migrate` (no Supabase CLI in this setup).
DATABASE_URL=

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# Resend
RESEND_API_KEY=
# Optional. Defaults to Resend's shared onboarding@resend.dev sender, which
# works without verifying a domain but only delivers to your own Resend
# account email while in test mode.
RESEND_FROM_EMAIL=
# Seeded agents have fake emails, so agent-facing notifications (new lead,
# tour request) go here instead. Point it at an inbox you control.
AGENT_NOTIFICATION_EMAIL=
# Flake's own inbox — cc'd on every "Contact Agent" lead alongside the
# listing agent, so the company always has a copy. Defaults to leads@flake.com.
FLAKE_NOTIFICATION_EMAIL=

# Anthropic
# Powers /api/ai-search (natural-language search box on /search). Without
# it, the route falls back to plain keyword matching.
ANTHROPIC_API_KEY=

# Cron
# Vercel sets this automatically for Vercel Cron-triggered requests when you
# set the same value as a project env var — protects /api/cron/* from being
# hit by anyone else. Generate any random string.
CRON_SECRET=
